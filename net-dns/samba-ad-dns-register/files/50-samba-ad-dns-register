#!/bin/bash
#
# networkd-dispatcher hook: register this host's DNS records in the Samba
# Active Directory zone whenever an interface becomes routable.
#
# Samba AD domain members (unlike Windows clients) do not periodically
# re-register their DNS records. Records are created once at join time and
# never refreshed. This hook restores Windows-netlogon-like behaviour by
# running `net ads dns register` each time a link becomes routable (initial
# lease and IP changes both transition the link back through routable).
#
# Installed by: net-dns/samba-ad-dns-register
#
# networkd-dispatcher invokes routable.d/ scripts with, among others:
#   IFACE              - the interface name (e.g. eth0)
#   OperationalState   - should be "routable" when run from routable.d
#   AdministrativeState
#   IP_ADDRS / IP6_ADDRS - space separated addresses on the link
#
# Configuration (optional), sourced from /etc/conf.d/samba-ad-dns-register
# if present:
#   SAMBA_AD_DNS_REGISTER_ENABLE   - set to "no" to disable (default: yes)
#   SAMBA_AD_DNS_REGISTER_IFACES   - space separated allow-list of interfaces
#                                    to act on. Empty = all non-virtual.
#   SAMBA_AD_DNS_REGISTER_NET      - path to the `net` binary (default: net in PATH)
#   SAMBA_AD_DNS_REGISTER_ARGS     - extra args passed to `net ads dns register`
#
set -u

TAG="samba-ad-dns-register"

log() { logger -t "${TAG}" -- "$*"; }

# --- load optional configuration -------------------------------------------
CONF="/etc/conf.d/samba-ad-dns-register"
# shellcheck disable=SC1090
[ -r "${CONF}" ] && . "${CONF}"

ENABLE="${SAMBA_AD_DNS_REGISTER_ENABLE:-yes}"
IFACES_ALLOW="${SAMBA_AD_DNS_REGISTER_IFACES:-}"
NET_BIN="${SAMBA_AD_DNS_REGISTER_NET:-net}"
EXTRA_ARGS="${SAMBA_AD_DNS_REGISTER_ARGS:-}"
# Retry tuning. At boot the link can be routable before a domain controller is
# reachable / DNS resolves / the clock is synced, so the first attempt often
# fails transiently ("No logon servers are currently available"). Retry a few
# times with a fixed delay before giving up.
RETRIES="${SAMBA_AD_DNS_REGISTER_RETRIES:-5}"
RETRY_DELAY="${SAMBA_AD_DNS_REGISTER_RETRY_DELAY:-10}"

case "${ENABLE}" in
	[Nn][Oo]|0|false|FALSE) exit 0 ;;
esac

# --- only act on genuine routable transitions -------------------------------
# When run from routable.d this should already be the case, but guard anyway.
if [ "${OperationalState:-}" != "routable" ]; then
	exit 0
fi

IFACE="${IFACE:-}"
if [ -z "${IFACE}" ]; then
	exit 0
fi

# --- interface filtering ----------------------------------------------------
# Skip loopback and common virtual/bridge/container interfaces to avoid
# registering addresses that should not appear in AD DNS. If an explicit
# allow-list is configured, honour only that.
if [ -n "${IFACES_ALLOW}" ]; then
	_ok="no"
	for _i in ${IFACES_ALLOW}; do
		[ "${_i}" = "${IFACE}" ] && _ok="yes"
	done
	[ "${_ok}" = "yes" ] || exit 0
else
	case "${IFACE}" in
		lo|docker*|veth*|virbr*|br-*|tap*|tun*|kube*|cni*|flannel*|zt*|wg*)
			exit 0
			;;
	esac
fi

# --- locate net -------------------------------------------------------------
if ! command -v "${NET_BIN}" >/dev/null 2>&1; then
	log "ERROR: '${NET_BIN}' not found; cannot register DNS for ${IFACE}"
	exit 0
fi

# --- determine the name and address(es) being registered --------------------
# `net ads dns register` with no explicit FQDN/IP registers this host's own
# name with its current interface addresses. We resolve the same values here
# purely so the journal records exactly what was registered. If the admin has
# pinned an explicit FQDN/IP via SAMBA_AD_DNS_REGISTER_ARGS we surface that
# instead, since that is what net will actually use.
REG_NAME="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "${HOSTNAME:-unknown}")"

# Addresses networkd-dispatcher reported for this link, if any; otherwise
# fall back to querying the interface directly. Filter to global-scope.
REG_ADDRS=""
if [ -n "${IP_ADDRS:-}" ] || [ -n "${IP6_ADDRS:-}" ]; then
	REG_ADDRS="$(printf '%s %s' "${IP_ADDRS:-}" "${IP6_ADDRS:-}" | tr -s ' ')"
elif command -v ip >/dev/null 2>&1; then
	REG_ADDRS="$(ip -o addr show dev "${IFACE}" scope global 2>/dev/null \
		| awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ')"
fi
REG_ADDRS="${REG_ADDRS#"${REG_ADDRS%%[![:space:]]*}"}" # ltrim
REG_ADDRS="${REG_ADDRS%"${REG_ADDRS##*[![:space:]]}"}" # rtrim
[ -n "${EXTRA_ARGS}" ] && REG_NAME="${REG_NAME} (+args: ${EXTRA_ARGS})"
: "${REG_ADDRS:=<autodetected by net>}"

# --- register ---------------------------------------------------------------
# --machine-pass authenticates using the machine account credentials from
# secrets.tdb, required because the AD zone uses secure dynamic updates.
#
# Retry on transient failures: at boot the link may be routable before a DC is
# reachable, DNS resolves, or the clock is synced. `net ads dns register`
# returns non-zero in those cases (e.g. "No logon servers are currently
# available"), and a later attempt usually succeeds. Attempt up to
# RETRIES+1 times, sleeping RETRY_DELAY seconds between tries.
log "link ${IFACE} routable; registering AD DNS name '${REG_NAME}' with address(es) [${REG_ADDRS}] (up to $((RETRIES + 1)) attempt(s))"

attempt=0
rc=0
out=""
while :; do
	attempt=$((attempt + 1))
	# shellcheck disable=SC2086
	out="$("${NET_BIN}" ads dns register --machine-pass ${EXTRA_ARGS} 2>&1)"
	rc=$?
	if [ "${rc}" -eq 0 ]; then
		log "AD DNS registration SUCCEEDED on attempt ${attempt}: name '${REG_NAME}' address(es) [${REG_ADDRS}] on ${IFACE}${out:+ -- ${out}}"
		exit 0
	fi

	if [ "${attempt}" -gt "${RETRIES}" ]; then
		log "AD DNS registration FAILED after ${attempt} attempt(s) (rc=${rc}): name '${REG_NAME}' address(es) [${REG_ADDRS}] on ${IFACE}${out:+ -- ${out}}"
		exit 0
	fi

	log "AD DNS registration attempt ${attempt} failed (rc=${rc}), retrying in ${RETRY_DELAY}s${out:+ -- ${out}}"
	sleep "${RETRY_DELAY}"
done
